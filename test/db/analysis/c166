NAME=c166: checking bitness writing (asm.bits)
FILE=malloc://32
CMDS=<<EOF
e asm.arch=c166
e asm.bits
EOF
EXPECT=<<EOF
16
EOF
RUN

NAME=c166 instruction length
FILE=malloc://32
CMDS=<<EOF
e asm.arch=c166
e asm.bits=16
wx 0012 @ 0
wx 3B @ 2
wx 6034 @ 3
ao 3~size
EOF
EXPECT=<<EOF
size: 2
size: 1
size: 2
EOF
RUN

