# cmd tests for MIL-STD-1750A via rizin: each instruction format
# verified through pi, including sequential multi-instruction disassembly

NAME=milstd1750: disasm all instruction formats
FILE=malloc://256
CMDS=<<EOF
e asm.arch=milstd1750
e asm.bits=8
wx FF00
pi 1
wx FFFF
pi 1
wx A112 8135 B112 A912
pi 4
wx 8222 820F A234
pi 3
wx 7410 7501 7620 7A30 7B60
pi 5
wx A0301234 80501234 90301234
pi 3
wx A0321234
pi 1
wx 0005 0105 0805
pi 3
wx 4005 4025 4035
pi 3
wx 4A51ABCD 4A321234 4A07ABCD
pi 3
wx 48302000
pi 1
wx 48320102
pi 1
wx 705F1234
pi 1
wx 6043 6121 6232 6522
pi 4
wx A8301234 B8205678 C810ABCD D8400100
pi 4
wx AA301234 AB12 EA34 EB12
pi 4
wx FF00 A112 A0301234 7410 FFFF
pi 5
EOF
EXPECT=<<EOF
NOP()
BPT()
AR(r1, r2)
LR(r3, r5)
SR(r1, r2)
FAR(r1, r2)
LISP(r2, 3)
LISP(r0, 16)
AISP(r3, 5)
BR(0x0010)
BEZ(0x0001)
BLT(0x0020)
BNZ(0x0030)
BGE(0x0060)
A(r3, 0x1234)
L(r5, 0x1234)
ST(r3, 0x1234)
A(r3, 0x1234, r2)
LB(r12, 5)
LB(r13, 5)
STB(r12, 5)
LBX(r12, r5)
STBX(r12, r5)
DSTX(r12, r5)
AIM(r5, 0xabcd)
SIM(r3, 0x1234)
ANDM(r0, 0xabcd)
XIO(r3, SMK)
XIO(r3, r2, PO { 1, 2 })
JC(0x5, 0x1234, r15)
SLL(r3, 5)
SRL(r1, 3)
SRA(r2, 4)
DSLL(r2, 3)
FA(r3, 0x1234)
FS(r2, 0x5678)
FM(r1, 0xabcd)
FD(r4, 0x0100)
EFA(r3, 0x1234)
EFAR(r1, r2)
EFIX(r3, r4)
EFLT(r1, r2)
NOP()
AR(r1, r2)
A(r3, 0x1234)
BR(0x0010)
BPT()
EOF
RUN

NAME=milstd1750: analysis BR (unconditional ICR jump)
FILE=malloc://1024
CMDS=<<EOF
e asm.arch=milstd1750
e asm.bits=8
s 0x100
wx 7410
ao~type,size,jump
EOF
EXPECT=<<EOF
size: 2
type: jmp
jump: 0x00000122
EOF
RUN

