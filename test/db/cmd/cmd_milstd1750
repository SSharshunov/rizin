# cmd tests for MIL-STD-1750A via rizin: each instruction format
# verified through pi, including sequential multi-instruction disassembly

NAME=milstd1750: disasm NOP
FILE=malloc://32
CMDS=<<EOF
e asm.arch=milstd1750
e asm.bits=8
wx FF00
pi 1
EOF
EXPECT=<<EOF
NOP()
EOF
RUN

NAME=milstd1750: disasm BPT
FILE=malloc://32
CMDS=<<EOF
e asm.arch=milstd1750
e asm.bits=8
wx FFFF
pi 1
EOF
EXPECT=<<EOF
BPT()
EOF
RUN

NAME=milstd1750: disasm register instructions
FILE=malloc://32
CMDS=<<EOF
e asm.arch=milstd1750
e asm.bits=8
wx A112 8135 B112 A912
pi 4
EOF
EXPECT=<<EOF
AR(r1, r2)
LR(r3, r5)
SR(r1, r2)
FAR(r1, r2)
EOF
RUN

NAME=milstd1750: disasm short immediate
FILE=malloc://32
CMDS=<<EOF
e asm.arch=milstd1750
e asm.bits=8
wx 8222 820F A234
pi 3
EOF
EXPECT=<<EOF
LISP(r2, 3)
LISP(r0, 16)
AISP(r3, 5)
EOF
RUN

NAME=milstd1750: disasm branch instructions
