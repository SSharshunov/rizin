NAME=milstd1750: open hand-written test_full.bin and check first instructions
FILE=bins/millstd1750/test_full.bin
ARGS=-a milstd1750 -b 8 -m 0x200
CMDS=<<EOF
e scr.color=false
s 0x200
pi 4
EOF
EXPECT=<<EOF
A(r1, 0x01e9)
AR(r1, r2)
AISP(r3, 5)
AIM(r4, 0x0064)
EOF
RUN

NAME=milstd1750: hand-written binary - all branch targets resolved by analysis
FILE=bins/millstd1750/test_full.bin
ARGS=-a milstd1750 -b 8 -m 0x200
CMDS=<<EOF
e scr.color=false
s 0x3a2
ao 3~type,jump
EOF
EXPECT=<<EOF
type: call
jump: 0x000003ce
type: call
jump: 0x000003ce
type: cjmp
jump: 0x000003c8
EOF
RUN

NAME=milstd1750: GCC-compiled C binary (Dhrystone) - aaa discovers multiple functions
FILE=bins/millstd1750/test_full2.bin
ARGS=-a milstd1750 -b 8 -m 0x200
CMDS=<<EOF
e scr.color=false
e analysis.calls=true
aaa 2>/dev/null
afl~?
EOF
EXPECT=<<EOF
14
EOF
RUN

NAME=milstd1750: GCC-compiled C binary - first function is increment() prologue+epilogue
FILE=bins/millstd1750/test_full2.bin
ARGS=-a milstd1750 -b 8 -m 0x200
CMDS=<<EOF
e scr.color=false
af @ 0x200
pdf @ 0x200
EOF
EXPECT=<<EOF
/ fcn.00000200();
|           0x00000200      LIM(r0, 0x06cb)
|           0x00000204      LIM(r1, 0x001e)
|           0x00000208      LIM(r2, 0x02d2)
|           0x0000020c      MOV(r0, r2)
|           0x0000020e      PSHM(r14, r14)
|           0x00000210      LR(r14, r15)
|           0x00000212      LR(r1, r0)
|           0x00000214      INCM(0, 0x0000, r1)
|           0x00000218      LR(r15, r14)
|           0x0000021a      POPM(r14, r14)
\           0x0000021c      URS(r15)
EOF
RUN

NAME=milstd1750: register profile exposes R0-R15, IC, SW, FT, MK, PI
FILE=malloc://32
ARGS=-a milstd1750 -b 8
CMDS=<<EOF
e scr.color=false
ar~?
EOF
EXPECT=<<EOF
21
EOF
RUN

NAME=milstd1750: status word flag bits cf, pf, zf, nf are individually accessible
FILE=malloc://32
ARGS=-a milstd1750 -b 8
CMDS=<<EOF
e scr.color=false
ar cf=1
ar pf=1
ar zf=1
ar nf=1
ar cf
ar pf
ar zf
ar nf
EOF
EXPECT=<<EOF
cf = 0x1
pf = 0x1
zf = 0x1
nf = 0x1
EOF
RUN

NAME=milstd1750: instruction counter (ic) is the program counter
FILE=malloc://32
ARGS=-a milstd1750 -b 8
CMDS=<<EOF
e scr.color=false
ar ic=0x1234
ar ic
EOF
EXPECT=<<EOF
ic = 0x1234
EOF
RUN

NAME=milstd1750: stack pointer is r15 (PSHM/POPM implicit, per spec 4.4.1.c)
FILE=malloc://32
ARGS=-a milstd1750 -b 8
CMDS=<<EOF
